{
  "name": "relaybase-desktop",
  "version": "0.1.2",
  "private": true,
  "description": "Relaybase desktop shell (Tauri + Next.js dual-mode)",
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "dev": "tauri dev",
    "build": "bash scripts/deploy/build-macos.sh",
    "build:macos": "bash scripts/deploy/build-macos.sh",
    "build:local": "pnpm exec tauri build --bundles app,dmg",
    "build:local:debug": "pnpm exec tauri build --debug --bundles app,dmg",
    "build:local:app": "pnpm exec tauri build --bundles app",
    "open:local:dmg": "bash -c 'open src-tauri/target/release/bundle/dmg/*.dmg'",
    "open:local:debug:dmg": "bash -c 'open src-tauri/target/debug/bundle/dmg/*.dmg'",
    "open:local:app": "open src-tauri/target/release/bundle/macos/Relaybase.app",
    "install:local": "pnpm run build:local && pnpm run open:local:dmg",
    "install:local:debug": "pnpm run build:local:debug && pnpm run open:local:debug:dmg",
    "sync:release": "node scripts/sync-release-artifacts.mjs",
    "upload:r2": "bash scripts/deploy/upload-release-r2.sh",
    "tauri": "tauri"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4"
  }
}
