# hq/crm local dev (see package.json `dev`)

# Public base URL for open/click/unsubscribe links embedded in outbound HTML
# CRM_PUBLIC_BASE_URL=https://relaybase.email

# Optional: domain-scoped Worker API key (rb-…) instead of syncing from the desktop app
# SCALE_WORKER_SEND_API_KEY=

# Log-only sender (no Worker HTTP) for UI tests
# CRM_SEND_STUB=1

# CRM API auth (production); omitted in dev
# CRM_API_SECRET=
