# --- Local dev (copy to `.env.local`) ---
RELAYBASE_URL=https://relaybase-api.example.workers.dev
NEXT_PUBLIC_CONSOLE_URL=https://console.relaybase.xyz
NEXT_PUBLIC_LICENSE_API_URL=https://console.relaybase.xyz
NEXT_PUBLIC_APP_URL=http://localhost:32830
# Same-origin so middleware can proxy Studio API (hq/studio on :32832, not :32831)
STUDIO_UPSTREAM_URL=http://127.0.0.1:32832
# HQ_JWT_SECRET=          # match hq/studio/.env.local
# HQ_INTERNAL_AUTH_SECRET= # match hq/studio (falls back to HQ_JWT_SECRET)
# RELAYBASE_SESSION_SECRET= # OAuth state cookie (random 32+ bytes)
# RELAYBASE_OAUTH_REDIRECT_URI=https://console.relaybase.xyz/oauth/callback

# --- Production (`hq-relaybase-web-app`, wrangler.web.jsonc) ---
# NEXT_PUBLIC_APP_URL=https://relaybase.email
# NEXT_PUBLIC_STUDIO_API_BASE=https://relaybase.email
# NEXT_PUBLIC_STUDIO_PUBLIC_BASE=https://relaybase.email
# STUDIO_UPSTREAM_URL=https://studio-api.relaybase.email
# Secrets (wrangler secret put): HQ_JWT_SECRET, HQ_INTERNAL_AUTH_SECRET — must match Railway hq/studio
