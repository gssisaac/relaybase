{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "relaybase-app",
  "main": "custom-worker.ts",
  "compatibility_date": "2026-07-12",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "account_id": "3adf03d991843094a7343eebc0a98007",
  "routes": [
    { "pattern": "app.relaybase.xyz", "custom_domain": true }
  ],
  // Background pulling for Audience Group data sources with cron enabled.
  // See src/lib/audience-cron.ts (fan-out) and custom-worker.ts (scheduled()).
  "triggers": { "crons": ["*/15 * * * *"] },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "relaybase-app"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "RELAYBASE_APP",
      // Remote bindings: next dev talks to production KV (not local miniflare),
      // so localhost domains/users match app.relaybase.xyz.
      "id": "dd520e7817004e77aa3f7d01d2ea2fb8",
      "preview_id": "dd520e7817004e77aa3f7d01d2ea2fb8",
      "remote": true
    },
    {
      "binding": "RELAYBASE_API",
      "id": "605b827fcf4c4f3c80641ec039500c99",
      "preview_id": "605b827fcf4c4f3c80641ec039500c99",
      "remote": true
    }
  ]
}
