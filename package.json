{
  "name": "relaybase",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npm run dev --prefix server",
    "deploy": "npm run deploy --prefix server",
    "typecheck": "npm run typecheck --prefix server",
    "admin:dev": "npm run dev --prefix hq/admin",
    "admin:build": "npm run build --prefix hq/admin",
    "admin:start": "npm run start --prefix hq/admin",
    "console:dev": "npm run dev --prefix hq/console",
    "console:build": "npm run build --prefix hq/console",
    "console:start": "npm run start --prefix hq/console",
    "app:dev": "npm run dev --prefix app",
    "app:build": "npm run build --prefix app",
    "app:start": "npm run start --prefix app",
    "desktop:dev": "pnpm --dir desktop dev",
    "desktop:build": "pnpm --dir desktop build",
    "desktop:build:macos": "pnpm --dir desktop build:macos",
    "icons:sync": "bash scripts/sync-brand-icons.sh",
    "mobile:setup": "cd mobile && ./scripts/setup.sh && flutter pub get",
    "mobile:ios": "cd mobile && flutter run -d ios",
    "mobile:android": "cd mobile && flutter run -d android",
    "mobile:build:ios": "cd mobile && flutter build ios --release",
    "mobile:build:apk": "cd mobile && flutter build apk --release",
    "mobile:test": "cd mobile && flutter test",
    "pack:worker-install": "npm run pack:customer-install --prefix server",
    "website:dev": "pnpm --dir hq/website dev",
    "website:build": "pnpm --dir hq/website build",
    "website:start": "pnpm --dir hq/website start"
  }
}
