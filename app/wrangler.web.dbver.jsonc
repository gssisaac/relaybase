{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Staging / DB-version preview — does not attach relaybase.email routes.
  // URL: https://hq-relaybase-web-app-dbver.gssisaac.workers.dev
  // Deploy: `pnpm run deploy:web:dbver`
  "name": "hq-relaybase-web-app-dbver",
  "compatibility_date": "2026-07-12",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "account_id": "3adf03d991843094a7343eebc0a98007",
  "workers_dev": true,
  "main": ".open-next/worker.js",
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "vars": {
    "NEXT_PUBLIC_APP_URL": "https://hq-relaybase-web-app-dbver.gssisaac.workers.dev",
    "CF_OAUTH_REDIRECT_URI": "https://hq-relaybase-web-app-dbver.gssisaac.workers.dev/api/oauth/callback",
    "CF_OAUTH_CLIENT_ID": "3164eafdded002cfeb713e36155711ed",
    "CF_OAUTH_EMAIL_API_CLIENT_ID": "f3d82701ae384f56ca1912c9335fcbed",
    "CF_OAUTH_EMAIL_API_SCOPES": "zone.read dns.write zone-settings.write email-routing-rule.write email-sending.write",
    "CF_OAUTH_PASSTOKEN_CLIENT_ID": "aa0716cdee578484a17aeff77eaf987d",
    "STUDIO_UPSTREAM_URL": "https://hq-relaybase-studio-dbver-production.up.railway.app"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "hq-relaybase-web-app-dbver"
    }
  ]
}
