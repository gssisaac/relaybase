{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default Relaybase desktop capabilities",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:tray:default",
    "core:menu:default",
    "core:window:allow-start-dragging",
    "core:webview:allow-set-webview-zoom",
