{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Production web app (OpenNext). Same Worker as the previous static
  // export: hq-relaybase-web-app on relaybase.email.
  //
  // `wrangler.jsonc` is still the desktop static-export config (`./out`).
  // `pnpm run deploy:cf` would overwrite this Worker with that SPA — do not
  // use it for production once this OpenNext worker is live.
  //
  // Deploy: `pnpm run deploy:web`
  "name": "hq-relaybase-web-app",
  "compatibility_date": "2026-07-12",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "account_id": "3adf03d991843094a7343eebc0a98007",
  "workers_dev": true,
  "main": ".open-next/worker.js",
  "routes": [
    { "pattern": "relaybase.email", "custom_domain": true },
    { "pattern": "www.relaybase.email", "custom_domain": true }
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "kv_namespaces": [
    {
      "binding": "hq_relaybase_feedback",
      "id": "9cb464c4ffaf460aa5157185663d5f85"
    }
  ],
  "r2_buckets": [
    {
      "binding": "hq_relaybase_feedback_r2",
      "bucket_name": "hq-relaybase-feedback"
    }
  ],
  "services": [
    {
      // Self-reference service binding, the service name must match the worker name
      // see https://opennext.js.org/cloudflare/caching
      "binding": "WORKER_SELF_REFERENCE",
      "service": "hq-relaybase-web-app"
    }
  ],
  "vars": {
    "NODE_ENV": "production",
    "NEXT_PUBLIC_APP_URL": "https://relaybase.email",
    "NEXT_PUBLIC_CONSOLE_URL": "https://console.relaybase.xyz",
    "NEXT_PUBLIC_LICENSE_API_URL": "https://console.relaybase.xyz",
    "NEXT_PUBLIC_STUDIO_API_BASE": "https://relaybase.email",
    "NEXT_PUBLIC_STUDIO_PUBLIC_BASE": "https://relaybase.email",
    "STUDIO_UPSTREAM_URL": "https://studio-api.relaybase.email"
  }
}
