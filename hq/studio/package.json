{
  "name": "relaybase-studio",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "tsx --env-file=.env dist/index.js",
    "typecheck": "tsc --noEmit",
    "deploy:cf": "wrangler deploy",
    "dev:cf": "wrangler dev",
    "migrate:templates-yaml": "node scripts/migrate-templates-to-yaml.mjs",
    "generate:message-template-thumbnails": "pnpm -C ../../app run generate:message-template-thumbnails"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "hono": "^4.7.11",
    "marked": "^15.0.7",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250317.0",
    "@types/node": "^20",
    "tsx": "^4.19.2",
    "typescript": "^5.8.3",
    "wrangler": "^4.120.0"
  }
}
