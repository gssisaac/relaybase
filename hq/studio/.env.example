# hq/studio local dev (see package.json `dev`)

# Public base URL for open/click/unsubscribe links embedded in outbound HTML
# STUDIO_PUBLIC_BASE_URL=https://relaybase.email

# Optional: domain-scoped Worker API key (rb-…) instead of syncing from the desktop app
# STUDIO_WORKER_SEND_API_KEY=

# Optional: Worker passtoken so Studio API can list /console/domains for cloud-only browsers
# STUDIO_WORKER_CONSOLE_PASSTOKEN=

# Log-only sender (no Worker HTTP) for UI tests
# STUDIO_SEND_STUB=1

# Studio API auth (required when NODE_ENV=production); optional in dev
# STUDIO_API_SECRET=

# Relaybase Studio web auth (signup / login / 30-day refresh cookie)
# Required when NODE_ENV=production — copy to .env (see package.json --env-file)
# HQ_JWT_SECRET=
# HQ_AUTH_APP_URL=http://localhost:32830
# HQ_AUTH_REFRESH_COOKIE=relaybase_hq_refresh
