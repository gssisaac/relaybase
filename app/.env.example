# Relaybase app — point at the deployed Worker (or local wrangler dev)
RELAYBASE_URL=https://relaybase-api.gssisaac.worker.dev
# Central account/auth/billing/license/recovery server (Next.js on Cloudflare)
NEXT_PUBLIC_CONSOLE_URL=https://console.relaybase.xyz
NEXT_PUBLIC_LICENSE_API_URL=https://console.relaybase.xyz

RELAYBASE_CF_ACCOUNT_ID=00000000000000000000000000000000
RELAYBASE_CF_API_TOKEN=cfut_temp_replace_me

RELAYBASE_CF_ZONE_ID=00000000000000000000000000000000
RELAYBASE_CF_DNS_API_TOKEN=cfut_temp_dns_replace_me
RELAYBASE_INBOUND_R2_BUCKET=relaybase-inbound

# Required for wrangler remote KV bindings during `next dev`
CLOUDFLARE_ACCOUNT_ID=00000000000000000000000000000000
CLOUDFLARE_API_TOKEN=cfut_temp_replace_me
