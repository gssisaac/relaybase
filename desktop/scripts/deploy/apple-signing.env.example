# Copy to scripts/deploy/apple-signing.env (gitignored) or set in ops-dashboard Release settings.
APPLE_SIGNING_IDENTITY="Developer ID Application: Your Company (TEAMID)"
APPLE_TEAM_ID=TEAMID
CSC_NAME="${APPLE_SIGNING_IDENTITY}"
CSC_IDENTITY_AUTO_DISCOVERY=false

# App Store Connect API key (recommended for notarization)
APPLE_API_ISSUER=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
APPLE_API_KEY=XXXXXXXXXX
APPLE_API_KEY_PATH=/absolute/path/to/AuthKey_XXXXXXXXXX.p8

# Or Apple ID + app-specific password:
# APPLE_ID=you@example.com
# APPLE_PASSWORD=xxxx-xxxx-xxxx-xxxx
