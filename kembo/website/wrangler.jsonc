{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "strum-relaybase-website",
  "account_id": "3adf03d991843094a7343eebc0a98007",
  "workers_dev": true,
  "compatibility_date": "2026-06-03",
  "routes": [
    { "pattern": "relaybase.xyz/*", "zone_name": "relaybase.xyz" },
    { "pattern": "www.relaybase.xyz/*", "zone_name": "relaybase.xyz" }
  ],
  "main": "src/worker/index.ts",
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/beta", "/api/beta/", "/downloads/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "strum-relaybase-ops",
      "database_id": "80aa8f9b-f83a-48b9-a7bd-7f3b8e100e28"
    }
  ]
}
