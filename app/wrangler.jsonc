{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "relaybase-app",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-07-12",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "account_id": "3adf03d991843094a7343eebc0a98007",
  "routes": [
    { "pattern": "app.relaybase.xyz", "custom_domain": true }
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "relaybase-app"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "RELAYBASE_APP",
      // Local OpenNext (wrangler dev) uses preview_id — keep it on the same
      // production namespace so localhost sees the same users/domains as deploy.
      "id": "dd520e7817004e77aa3f7d01d2ea2fb8",
      "preview_id": "dd520e7817004e77aa3f7d01d2ea2fb8"
    },
    {
      "binding": "RELAYBASE_API",
      "id": "605b827fcf4c4f3c80641ec039500c99",
      "preview_id": "605b827fcf4c4f3c80641ec039500c99"
    }
  ]
}
