node_modules/
dist/
*.log
.DS_Store
.wrangler/
data/products/
data/users/*.json
!data/users.json

# Secrets — never commit real env files (examples are fine)
.env
.env.*
!.env.example
!**/.env.example
.dev.vars
!**/.dev.vars.example

# server/ is outside the pnpm workspace; keep its local lockfile untracked
server/pnpm-lock.yaml

# Claude Code local git worktrees — full checkout copies, never commit
.claude/worktrees/

# Local Studio JSON store (dev) — never commit data files
hq/studio/data/*
!hq/studio/data/.gitkeep
# Sharded store lives in hq/studio/data/store/*.json (ignored by rule above)
