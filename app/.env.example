# Relaybase app — point at the deployed Worker (or local wrangler dev)
RELAYBASE_URL=https://relaybase-api.gssisaac.worker.dev
# Central account/auth/billing/license/recovery server (Next.js on Cloudflare)
NEXT_PUBLIC_CONSOLE_URL=https://console.relaybase.xyz
NEXT_PUBLIC_LICENSE_API_URL=https://console.relaybase.xyz
# Web Cloudflare OAuth uses the console-registered redirect URI
# (https://console.relaybase.xyz/oauth/callback). The console then bounces
# back to this origin's /api/oauth/callback. Do not set
# RELAYBASE_OAUTH_REDIRECT_URI to relaybase.email — that URI is not on the
# OAuth client and Cloudflare returns invalid_request.
# NEXT_PUBLIC_APP_URL=http://localhost:32830
# Optional: force Studio API origin (default: same-origin on localhost dev, relaybase.email in prod)
# NEXT_PUBLIC_STUDIO_API_BASE=https://relaybase.email
# Unsubscribe/open links in preview + outbound mail (default https://relaybase.email)
# NEXT_PUBLIC_STUDIO_PUBLIC_BASE=https://relaybase.email
# Server-only (Next middleware): hq/studio upstream for /studio/* and /auth/* proxy (pnpm dev in hq/studio)
# Default :32832 — do not use :32831 (desktop CF OAuth loopback when Relaybase.app is running)
# STUDIO_UPSTREAM_URL=http://127.0.0.1:32832
# Production (Wrangler): https://studio-api.relaybase.email
# Cloud-unified auth — must match hq/studio (see docs/auth/cloud-entry-auth.md)
# HQ_JWT_SECRET=
# HQ_INTERNAL_AUTH_SECRET=
# Do not point NEXT_PUBLIC_STUDIO_API_BASE at production while testing local data/store.json
# RELAYBASE_OAUTH_REDIRECT_URI=https://console.relaybase.xyz/oauth/callback
