PORT=32832

# --- PostgreSQL (Railway) ---
# App DB name: relaybase (create with `pnpm run orm:ensure-db`)
#
# On Railway (private network, same project as Postgres):
# DATABASE_ADMIN_URL=postgresql://postgres:PASSWORD@postgres.railway.internal:5432/railway
# DATABASE_URL=postgresql://postgres:PASSWORD@postgres.railway.internal:5432/relaybase
#
# From your laptop (TCP proxy — copy DATABASE_PUBLIC_URL from Postgres service variables):
# DATABASE_PUBLIC_URL=postgresql://postgres:PASSWORD@HOST.proxy.rlwy.net:PORT/railway
# DATABASE_URL=postgresql://postgres:PASSWORD@HOST.proxy.rlwy.net:PORT/relaybase

# Dev-only: auto-create tables from entities (`pnpm run orm:sync` / `pnpm run orm:setup`)
# TYPEORM_SYNC=1

# TYPEORM_LOGGING=1
# DATABASE_SSL=1
