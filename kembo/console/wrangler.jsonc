{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "strum-relaybase-console",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-07-12",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "account_id": "3adf03d991843094a7343eebc0a98007",
  "workers_dev": true,
  "routes": [
    { "pattern": "console.relaybase.xyz", "custom_domain": true }
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "strum-relaybase-console"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "strum-relaybase-ops",
      "database_id": "80aa8f9b-f83a-48b9-a7bd-7f3b8e100e28",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "CF_OAUTH_CLIENT_ID": "ce3fb54a8795ba0abb7dd11e611d74d9",
    "CF_OAUTH_REDIRECT_URI": "https://console.relaybase.xyz/oauth/callback"
  }
}
