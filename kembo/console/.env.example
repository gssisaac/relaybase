# Relaybase console — central account/billing/license server
# Default local dev points at the dogfood product Worker.
RELAYBASE_URL=https://relaybase-api.gssisaac.worker.dev

# Stripe (optional until billing ships)
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_PRO=price_...
# STRIPE_PRICE_PRO_ANNUAL=price_...
# STRIPE_CUSTOMER_PORTAL_CONFIG=bpc_...

# Session signing / recovery token signing (wrangler secret put in prod)
# CONSOLE_SESSION_SECRET=
# RECOVERY_SIGNING_SECRET=

